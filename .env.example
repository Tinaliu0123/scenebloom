# Copy to .env and fill in. The scripts under scripts/ load this file, and its values
# replace those set in the shell.

# Required: the VLM (qwen/qwen3-vl-8b-instruct) is called through OpenRouter.
OPENROUTER_API_KEY=

# Required by scripts/download/download_models.sh: FLUX.1-dev is a gated model.
HF_TOKEN=
